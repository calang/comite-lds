# Never commit .env to version control!

# env vars for the project
PROJECT_ROOT=$(pwd)
DATA=$PROJECT_ROOT/data

PYTHONPATH=$PROJECT_ROOT

GITHUB_API_TOKEN=<--your_github_api_token-->
ANTHROPIC_API_KEY="your-claude-key"

# enable LSP tool for code generation and analysis by Claude Code
ENABLE_LSP_TOOL=1
# Note: requires a language server to be installed.
# For Python:  pip install pyright
# For Prolog:  ?- pack_install(lsp_server).


# Application Settings
# DEBUG=True
LOG_LEVEL=INFO
